{%- for session in history %}

[Session {{ loop.index }}]
▶ Stage：{{ session.session_stage }}
▶ Dialogue Summary：{{ session.session_summary_abstract }}
{%- if session.client_state_analysis %}

▶ Client State Analysis:
- Affective State：{{ session.client_state_analysis.affective_state }}
- Existential Topics: {{ session.client_state_analysis.existentialism_topic }}
- Behavioral Patterns：{{ session.client_state_analysis.behavioral_patterns }}
- Therapeutic Alliance：{{ session.client_state_analysis.therapeutic_alliance }}
- Unresolved Points / Tensions：{{ session.client_state_analysis.unresolved_points_or_tensions }}
{%- endif %}

{%- endfor %}
{%- else %}

(No prior session records)
{%- endif %}

