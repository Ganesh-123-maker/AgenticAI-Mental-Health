[Current Therapy Stage]
{{session_stage}}

[Client Background Information]
{% if client_info -%}
{% set info = client_info.static_traits or {} -%}
{% macro line(label, value) -%}
- {{ label }}：{{ value | default('Unknown', true) }}
{%- endmacro -%}
1. Basic Information
{{ line('Name', info.name) }}
{{ line('Age', info.age) }}
{{ line('Gender', info.gender) }}
{{ line('Occupation', info.occupation) }}
{{ line('Educational Background', info.educational_background) }}
{{ line('Marital Status', info.marital_status) }}

2. Family and Social Relationships
{{ line('Family Background', info.family_status) }}
{{ line('Social Relationship Status', info.social_status) }}

3. Physical and Mental Health
{{ line('Medical History', info.medical_history) }}

4. Chief Complaint and Counseling Goals
{{ line('Chief Complaint', client_info.main_problem) }}
{{ line('Counseling Topic', client_info.topic) }}
{{ line('Core Demands', client_info.core_demands) }}

5. Growth Experiences
{% if client_info.growth_experiences -%}
{% for exp in client_info.growth_experiences -%}
  - {{ loop.index }}. {{ exp }}
{% endfor -%}
{% else -%}
- Unknown
{% endif %}
6. Existential Topics
{%- if client_info.existentialism_topic -%}
{%- for s in client_info.existentialism_topic -%}
  {% if s.theme is defined %}
  - Topic {{ loop.index }}:
    - Topic Theme: {{ s.theme | default('Unknown', true) }}
    - Related Description: 
    {%- if s.manifestations %}
      {%- for a in s.manifestations if a %}
      - {{ a }}
      {%- endfor %}
    {%- else %}
      None recorded
    {% endif %}
    - Outcomes: 
    {%- if s.outcomes %}
      {%- for a in s.outcomes if a %}
      - {{ a }}
      {%- endfor %}
    {%- else %}
      None recorded
    {% endif %}
  {% else -%}
  - Topic {{ loop.index }}:{{ s }}
  {% endif -%}
{% endfor -%}
{% else -%}
- Topic: Unknown
{% endif %}
7. Contact Boundary Styles
{%- if client_info.contact_model -%}
{%- for s in client_info.contact_model -%}
  {% if s.mode is defined %}
  - Mode {{ loop.index }}:{{ s.mode | default('Unknown', true) }}
    - Definition: {{ s.definition | default('Unknown', true) }}
    - Specific Manifestations: 
    {%- if s.manifestations %}
      {%- for a in s.manifestations if a %}
      - {{ a }}
      {%- endfor %}
    {%- else %}
      None recorded
    {% endif %}
  {% else -%}
  - Mode {{ loop.index }}:{{ s }}
  {% endif -%}
{% endfor -%}
{% else -%}
- Mode: Unknown
{% endif -%}
{% else %}
(Current profile is empty)
{% endif %}
---

[Session Focus Goals]{% for focus in session_focus %}
- {{focus}}{% endfor %}

