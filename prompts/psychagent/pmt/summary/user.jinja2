[Current Therapy Stage]
{{session_stage}}

[Client Background Information]
{% if client_info -%}
{% set info = client_info.static_traits or {} -%}
{% macro line(label, value) -%}
- {{ label }}：{{ value | default('Unknown', true) }}
{%- endmacro -%}
1. Basic Information
{{ line('Name', info.name) }}
{{ line('Age', info.age) }}
{{ line('Gender', info.gender) }}
{{ line('Occupation', info.occupation) }}
{{ line('Educational Background', info.educational_background) }}
{{ line('Marital Status', info.marital_status) }}

2. Family and Social Relationships
{{ line('Family Background', info.family_status) }}
{{ line('Social Relationship Status', info.social_status) }}

3. Physical and Mental Health
{{ line('Medical History', info.medical_history) }}

4. Chief Complaint and Counseling Goals
{{ line('Chief Complaint', client_info.main_problem) }}
{{ line('Counseling Topic', client_info.topic) }}
{{ line('Core Demands', client_info.core_demands) }}

5. Growth Experiences
{% if client_info.growth_experiences -%}
{% for exp in client_info.growth_experiences -%}
  - {{ loop.index }}. {{ exp }}
{% endfor -%}
{% else -%}
- Unknown
{% endif %}
6. Exception Events
{%- if client_info.exception_events -%}
{%- for s in client_info.exception_events -%}
  {% if s.target_problem is defined %}
  - Event {{ loop.index }}:
    - Target Problem: {{ s.target_problem | default('Unknown', true) }}
    - Unique Outcome: {{ s.unique_outcome | default('Unknown', true) }}
    - Attributed Reason: {{ s.reason | default('Unknown', true) }}
  {% else -%}
  - Event {{ loop.index }}:{{ s }}
  {% endif -%}
{% endfor -%}
{% else -%}
- Event: Unknown
{% endif %}
7. Force Field Analysis
{%- if client_info.force_field -%}
{% set s = client_info.force_field or {} %}
  - Positive Forces: 
  {%- if s.positive_force %}
    {%- for a in s.positive_force if a %}
    - {{ a }}
    {%- endfor %}
  {%- else %}
    None recorded
  {% endif %}
  - Negative Forces: 
  {%- if s.negative_force %}
    {%- for a in s.negative_force if a %}
    - {{ a }}
    {%- endfor %}
  {%- else %}
    None recorded
  {% endif %}
{% else -%}
- Force Field: Unknown
{% endif -%}
{% else %}
(Current profile is empty)
{% endif %}
