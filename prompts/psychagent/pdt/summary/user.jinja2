[Client Background Information]
{% if client_info -%}
{% set info = client_info.static_traits or {} -%}
{% macro line(label, value) -%}
- {{ label }}：{{ value | default('Unknown', true) }}
{%- endmacro -%}
1. Basic Information
{{ line('Name', info.name) }}
{{ line('Age', info.age) }}
{{ line('Gender', info.gender) }}
{{ line('Occupation', info.occupation) }}
{{ line('Educational Background', info.educational_background) }}
{{ line('Marital Status', info.marital_status) }}

2. Family and Social Relationships
{{ line('Family Background', info.family_status) }}
{{ line('Social Relationship Status', info.social_status) }}

3. Physical and Mental Health
{{ line('Medical History', info.medical_history) }}

4. Chief Complaint and Counseling Goals
{{ line('Chief Complaint', client_info.main_problem) }}
{{ line('Counseling Topic', client_info.topic) }}
{{ line('Core Demands', client_info.core_demands) }}

5. Growth Experiences
{% if client_info.growth_experiences -%}
{% for exp in client_info.growth_experiences -%}
  - {{ loop.index }}. {{ exp }}
{% endfor -%}
{% else -%}
- Unknown
{% endif %}
6. Core Conflict
{%- if client_info.core_conflict -%}
{% set s = client_info.core_conflict or {} %}
  - Deep Wish: {{ s.wish | default('Unknown', true) }}
  - Core Anxiety: {{ s.fear | default('Unknown', true) }}
  - Defense Goal: 
  {%- if s.defense_goal %}
    {%- for a in s.defense_goal if a %}
    - {{ a }}
    {%- endfor %}
  {%- else %}
    None recorded
  {% endif %}
{% else -%}
- Conflict: Unknown
{% endif %}
7. Object Relations
{%- if client_info.object_relations -%}
{%- for s in client_info.object_relations -%}
  {% if s.self_representation is defined %}
  - Relationship {{ loop.index }}:
    - Self Representation: {{ s.self_representation | default('Unknown', true) }}
    - Object Representation: {{ s.object_representation | default('Unknown', true) }}
    - Linking Affect: {{ s.linking_affect | default('Unknown', true) }}
  {% else -%}
  - Relationship {{ loop.index }}:{{ s }}
  {% endif -%}
{% endfor -%}
{% else -%}
- Relationship: Unknown
{% endif %}
8. Defense Mechanisms
{%- if client_info.behavioral_response_patterns -%}
{%- for s in client_info.behavioral_response_patterns -%}
  {% if s.trigger_condition is defined %}
  - Mechanism {{ loop.index }}:
    - Trigger Condition: {{ s.trigger_condition | default('Unknown', true) }}
    - Transference Projection: {{ s.interpretation | default('Unknown', true) }}
    - Defense Mechanism: {{ s.defense_mechanism | default('Unknown', true) }}
    - Response Directive: {{ s.response_instruction | default('Unknown', true) }}
  {% else -%}
  - Mechanism {{ loop.index }}:{{ s }}
  {% endif -%}
{% endfor -%}
{% else -%}
- Mechanism: Unknown
{% endif -%}
{% else %}
(Current profile is empty)
{% endif %}
